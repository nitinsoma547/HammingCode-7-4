# ------------------------------------------------------------------------------
# .env.example — source of truth for required env vars.
# Copy to .env (NEVER commit .env). All secrets read via api/src/lib/config.ts.
# ------------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000

# ---- Anthropic (Claude Haiku for content generation) -------------------------
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---- Meta Graph API (Facebook Pages + Instagram Business) --------------------
# Long-lived Page Access Token. Generate via the Meta App's Graph API Explorer
# after App Review approves instagram_content_publish + pages_manage_posts.
# Refresh roughly every 60 days. See META_SETUP.md.
META_PAGE_ACCESS_TOKEN=
META_FB_PAGE_ID=
META_IG_USER_ID=
META_GRAPH_API_VERSION=v21.0

# App-level (only needed for the OAuth refresh flow, not for basic posting)
META_APP_ID=
META_APP_SECRET=

# ---- Outstand (fallback for posting while Meta App Review is pending) --------
OUTSTAND_API_KEY=

# ---- Resend (monthly email blast) --------------------------------------------
# https://resend.com/api-keys
RESEND_API_KEY=

# ---- FAL.AI (Kling 3.0 image-to-video for Reels) -----------------------------
# https://fal.ai/dashboard/keys
FAL_KEY=

# ---- Stripe (subscriptions + onboarding fee) ---------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Supabase (Postgres + storage) -------------------------------------------
# Service-role key — backend only, never exposed to the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Google Places (lead-gen scrapers, local Python only) --------------------
GOOGLE_PLACES_API_KEY=
